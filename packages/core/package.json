{
  "name": "@evu/harness-core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "EvuHarness headless runtime: sessions, modes, grants, tools, prompts, and context menus.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
