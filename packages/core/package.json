    "dist",
    "src"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/refuse-publish.mjs",
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@evu/harness-protocol": "workspace:*",
    "zod": "^4.1.13"
  }
}
