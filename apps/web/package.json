{
  "name": "@evu/harness-web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "EvuHarness demo web app: a thin shell over @evu/harness-ui.",
  "type": "module",
  "scripts": {
    "prepublishOnly": "node ../../scripts/refuse-publish.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite --host 0.0.0.0 --port 4300",
    "preview": "vite preview --host 0.0.0.0 --port 4300",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@evu/harness-protocol": "workspace:*",
    "@evu/harness-ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.4"
  }
}
