{
  "name": "evuharness",
  "private": true,
  "version": "0.0.0",
  "description": "EvuHarness reusable AI chat harness: headless runtime, protocol, server adapter, and React UI kit.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm --filter @evu/harness-web build",
    "clean": "tsc -b tsconfig.json --clean",
    "dev": "docker compose --project-directory . -f deploy/docker-compose.dev.yml up --build",
    "down": "docker compose --project-directory . -f deploy/docker-compose.dev.yml down",
    "format": "biome format --write .",
    "lint": "biome check . && bash scripts/public-tree-scan.sh && bash scripts/docs-check.sh && bash scripts/release-guard.sh && bash scripts/test-release-guard.sh",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "node scripts/refuse-publish.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b tsconfig.json && pnpm -r --if-present typecheck",
    "up": "docker compose --project-directory . -f deploy/docker-compose.dev.yml up --build -d",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "verify-dev": "pnpm run verify && docker compose --project-directory . -f deploy/docker-compose.dev.yml config >/dev/null"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.9"
  }
}
